# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # find it with: .venv/bin/python tools/tts.py --list-voices

# YouTube: put the OAuth "Desktop app" client file at secrets/youtube_client.json
# (token is saved to secrets/youtube_token.json after the first sign-in)

INSTAGRAM_USER_ID=            # the Instagram Business/Creator account id
INSTAGRAM_ACCESS_TOKEN=       # long-lived token with instagram_content_publish
