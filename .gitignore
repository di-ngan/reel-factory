# secrets and local setup
.env
secrets/
config.local.json
.venv/
__pycache__/
.DS_Store

# workspace = your own work; only the guides and templates are tracked
workspace/reels/*
!workspace/reels/README.md
workspace/subs/
workspace/content_bank.md
workspace/preferences.json
workspace/media/*
!workspace/media/README.md
!workspace/media/episodes/
workspace/media/episodes/*
!workspace/media/episodes/.gitkeep
!workspace/media/clips/
workspace/media/clips/*
!workspace/media/clips/.gitkeep
workspace/references/*
!workspace/references/README.md
!workspace/references/links.md

# downloads a kit fetches during setup (any kit)
reel_kits/*/node_modules/
reel_kits/*/lib/
reel_kits/*/package-lock.json
