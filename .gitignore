.env
secrets/
.venv/
__pycache__/

# reels are local work; only the format guide is tracked
reels/*
!reels/README.md
.DS_Store

# subtitles are extracted locally (tools/subs.py extract)
subs/

# your own settings and idea list
config.local.json
content_bank.md
media/*
!media/README.md
!media/episodes/
media/episodes/*
!media/episodes/.gitkeep
!media/clips/
media/clips/*
!media/clips/.gitkeep

# reference reels are personal; only the guide is tracked
references/*
!references/README.md
!references/links.md

# cartoon kit downloads (fetched by reelkit.cartoon setup)
kits/cartoon/node_modules/
kits/cartoon/lib/
kits/cartoon/package-lock.json
reels/*/frames/
preferences.json
